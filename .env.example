# AWFace - variáveis de ambiente do Docker Compose.
# Copie para .env e preencha os valores. O arquivo .env NUNCA deve ser versionado.
# Gere chaves com:  openssl rand -base64 32

POSTGRES_DB=awface
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Interface onde o Postgres é publicado no host (127.0.0.1 = somente local).
POSTGRES_BIND=127.0.0.1

# Release AWFace. Deve ser igual ao conteúdo do arquivo VERSION.
AWFACE_VERSION=1.1.0
AWFACE_BUILD_COMMIT=unknown
AWFACE_BUILD_DATE=unknown

AWFACE_FRONT_PORT=5580
AWFACE_API_PORT=5500
# Interface onde a API é publicada no host. Hosts devem usar o Nginx (/api).
AWFACE_API_BIND=127.0.0.1
AWFACE_FRONTEND_BASE_URL=http://localhost:5580
AWFACE_LIVENESS_APPKEY_LIFETIME_MINUTES=20
# Engine de prova de vida para novas jornadas. Valores aceitos: V9 ou V10.
AWFACE_LIVENESS_ENGINE=V9

# Obrigatórias. A API não inicia fora de Development com chaves vazias, curtas ou de exemplo.
# Chave mestra dos dados pessoais (CPF, nome, nascimento) e segredos de Tenant (AES-256-GCM).
AWFACE_DATA_ENCRYPTION_KEY=
# Chave das imagens de face (AES-256-GCM).
AWFACE_FACE_STORAGE_ENCRYPTION_KEY=
# Chave anterior das imagens, somente leitura, para rotação (ex.: a antiga "troque-esta-chave-em-producao").
AWFACE_FACE_STORAGE_PREVIOUS_ENCRYPTION_KEY=
# Opcional: chave HMAC dos tokens de admin e de jornada. Vazia = derivada da chave mestra.
AWFACE_TOKEN_SIGNING_KEY=
AWFACE_ADMIN_TOKEN_LIFETIME_MINUTES=60
AWFACE_JOURNEY_TOKEN_LIFETIME_MINUTES=120

# Administrador inicial: usado apenas quando não existe nenhum administrador no banco.
# Senha com 12+ caracteres. Remova AWFACE_ADMIN_PASSWORD após o primeiro acesso.
AWFACE_ADMIN_EMAIL=
AWFACE_ADMIN_PASSWORD=

# Entrega do webhook ao Tenant (fila com retentativa exponencial).
AWFACE_WEBHOOK_MAX_ATTEMPTS=10
AWFACE_WEBHOOK_TIMEOUT_SECONDS=10
# Somente para teste local com a API em Docker: Tenants cujo UrlCallback/Token URL apontam para
# localhost (ex.: Portal em https://localhost:44305) passam a ser chamados em host.docker.internal,
# aceitando o certificado de desenvolvimento. Deixe vazio em servidores.
AWFACE_WEBHOOK_LOCALHOST_ALIAS=
AWFACE_LOG_RETENTION_DAYS=30

CERTIFACE_BASE_URL=https://hml.certiface.com.br
CERTIFACE_RESULT_BASE_URL=https://hml.certiface.com.br:8443

ASPNETCORE_ENVIRONMENT=Production
TZ=America/Sao_Paulo
