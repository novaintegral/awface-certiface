<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <VersionFile>$(MSBuildThisFileDirectory)../../VERSION</VersionFile>
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
    <RepositoryUrl>https://github.com/novaintegral/awface-certiface</RepositoryUrl>
    <Product>AWFace</Product>
    <Description>AWFace liveness orchestration API</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>
</Project>
