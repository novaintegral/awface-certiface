{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "FileNamePrefix": "awface-api",
      "MinimumLevel": "Information",
      "RetentionDays": 30
    }
  },
  "ConnectionStrings": {
    "Awface": ""
  },
  "Awface": {
    "Schema": "public",
    "FrontendBaseUrl": "http://localhost:4200",
    "LivenessAppkeyLifetimeMinutes": 20,
    "LivenessEngine": "V9",
    "TrustForwardedHeaders": false,
    "Security": {
      "DataEncryptionKey": "",
      "TokenSigningKey": "",
      "AdminTokenLifetimeMinutes": 60,
      "JourneyTokenLifetimeMinutes": 120
    },
    "Webhook": {
      "MaxAttempts": 10,
      "TimeoutSeconds": 10,
      "DeferCompletionAfterAttempts": 3
    },
    "FaceStorage": {
      "RootPath": "storage/faces",
      "EncryptionKey": ""
    },
    "Admin": {
      "Email": "",
      "Password": ""
    },
    "Cors": {
      "AllowedOrigins": []
    }
  },
  "Certiface": {
    "BaseUrl": "https://hml.certiface.com.br",
    "ResultBaseUrl": "https://hml.certiface.com.br:8443"
  }
}
