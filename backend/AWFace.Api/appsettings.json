{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "FileNamePrefix": "awface-api",
      "MinimumLevel": "Information"
    }
  },
  "ConnectionStrings": {
    "Awface": "Host=localhost;Port=5432;Database=awface;Username=postgres;Password=assinaweb;Search Path=public;Include Error Detail=true"
  },
  "Awface": {
    "Schema": "public",
    "FrontendBaseUrl": "http://localhost:4200",
    "LivenessAppkeyLifetimeMinutes": 20,
    "LivenessEngine": "V9",
    "FaceStorage": {
      "RootPath": "storage/faces",
      "EncryptionKey": "dev-only-change-this-face-storage-key"
    },
    "Admin": {
      "Email": "admin@awface.local",
      "Password": "Awface@123"
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ]
    }
  },
  "Certiface": {
    "BaseUrl": "https://hml.certiface.com.br",
    "ResultBaseUrl": "https://hml.certiface.com.br:8443"
  }
}
